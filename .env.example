# Runtime
APP_ENVIRONMENT=development
API_CORS_ORIGINS=http://localhost:5173

# Supabase public project values
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Backend only. Put the real value in the untracked .env file.
SUPABASE_SECRET_KEY=your-backend-secret-key

# Backend only: Brandfetch search/logo proxy. Never put these in VITE_* values.
BRANDFETCH_API_KEY=
BRANDFETCH_CLIENT_ID=

# Backend only: OpenAI image analysis
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_DAILY_ANALYSIS_LIMIT=10
OPENAI_DAILY_COST_LIMIT_USD=0.20

# Backend only: Web Push and scheduled notification worker
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
NOTIFICATION_CRON_SECRET=
NOTIFICATION_MAX_ATTEMPTS=3

# Backend only: delete email-unconfirmed Auth users after the retention period.
UNVERIFIED_ACCOUNT_CLEANUP_CRON_SECRET=
UNVERIFIED_ACCOUNT_RETENTION_DAYS=7

# Backend only: Google Calendar one-way export
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/google-calendar/callback
# Generate a Fernet key and keep the real value only in .env.
GOOGLE_TOKEN_ENCRYPTION_KEY=
GOOGLE_CALENDAR_CRON_SECRET=
FRONTEND_APP_URL=http://localhost:5173

# Backend only: comma-separated Supabase user UUIDs allowed to review Phase 8 content.
PHASE8_OPERATOR_USER_IDS=
CONTENT_COLLECTION_MODEL=gpt-5.4-mini
CONTENT_COLLECTION_CRON_SECRET=
CONTENT_DAILY_COST_LIMIT_USD=0.50
CONTENT_DEVELOPMENT_TOTAL_LIMIT_USD=10.00
CONTENT_ESTIMATED_COST_PER_SEARCH_USD=0.05
CONTENT_COLLECTION_INTERVAL_HOURS=72
CONTENT_DAILY_SERVICE_JOB_LIMIT=5
CONTENT_MAX_INPUT_TOKENS=16000
CONTENT_MAX_OUTPUT_TOKENS=2000
CONTENT_MAX_WEB_SEARCH_CALLS=2
CONTENT_MODEL_INPUT_COST_PER_MILLION_USD=0.75
CONTENT_MODEL_CACHED_INPUT_COST_PER_MILLION_USD=0.075
CONTENT_MODEL_OUTPUT_COST_PER_MILLION_USD=4.50
CONTENT_WEB_SEARCH_COST_PER_CALL_USD=0.01
CONTENT_OTT_EDITORIAL_ENABLED=true
# all: subscribed services and OTT editorial feed; ott_editorial: upcoming OTT titles only.
CONTENT_COLLECTION_SCOPE=all

# Frontend values are embedded in the browser bundle and must never contain secrets.
VITE_API_BASE_URL=http://localhost:8000
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Never expose SUPABASE_SECRET_KEY, service_role keys, passwords, or API secrets to VITE_* values.
